#define AP_RID_DIALOG_RDFREFERENCE_LBL			1001
#define AP_RID_DIALOG_RDFREFERENCE_LIST			1002

#ifdef RC_INVOKED

AP_RID_DIALOG_RDFREFERENCE DIALOG DISCARDABLE  15, 15, 280, 160
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Insert Reference to Semantic Item"
FONT 9, "Segoe UI"
BEGIN
	LTEXT			"Contacts",	AP_RID_DIALOG_RDFREFERENCE_LBL, 7, 6, 200, 10
	LISTBOX						AP_RID_DIALOG_RDFREFERENCE_LIST, 7, 18, 266, 112, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
	DEFPUSHBUTTON	"Insert Reference", IDOK, 7, 138, 140, 14
	PUSHBUTTON		"Cancel",	IDCANCEL, 155, 138, 70, 14
END

#endif
