#define AP_RID_DIALOG_RDFQUERY_EDIT			1001
#define AP_RID_DIALOG_RDFQUERY_LIST			1002
#define AP_RID_DIALOG_RDFQUERY_STATUS		1003
#define AP_RID_DIALOG_RDFQUERY_BTN_SHOWALL	1004
#define AP_RID_DIALOG_RDFQUERY_BTN_EXECUTE	1005
#define AP_RID_DIALOG_RDFQUERY_BTN_CLOSE	IDCANCEL

#ifdef RC_INVOKED

AP_RID_DIALOG_RDFQUERY DIALOG DISCARDABLE  0, 0, 420, 280
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Execute SPARQL on document RDF"
FONT 8, "MS Shell Dlg 2"
BEGIN
	EDITTEXT		AP_RID_DIALOG_RDFQUERY_EDIT, 7, 7, 406, 90, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
	CONTROL			"", AP_RID_DIALOG_RDFQUERY_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 102, 406, 130
	LTEXT			"", AP_RID_DIALOG_RDFQUERY_STATUS, 7, 236, 250, 10
	PUSHBUTTON		"Show All RDF", AP_RID_DIALOG_RDFQUERY_BTN_SHOWALL, 188, 258, 70, 14
	DEFPUSHBUTTON	"Execute Query", AP_RID_DIALOG_RDFQUERY_BTN_EXECUTE, 262, 258, 70, 14
	PUSHBUTTON		"Close", AP_RID_DIALOG_RDFQUERY_BTN_CLOSE, 336, 258, 70, 14
END

#endif /* RC_INVOKED */
